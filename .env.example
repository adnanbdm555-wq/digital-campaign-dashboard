# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000
# The real, public HTTPS URL once deployed (e.g. https://reports.adpulse.pk).
# For local testing this can stay as http://localhost:3000 — see README.
BASE_URL=http://localhost:3000

# Any random long string — used to sign the login session cookie.
SESSION_SECRET=change-this-to-something-random

# Optional: if set, POST /api/refresh requires ?key=THIS_VALUE.
# Leave blank while testing locally.
REFRESH_SECRET=

# How often to auto-pull data. Cron syntax. Default = every 6 hours.
CRON_SCHEDULE=0 */6 * * *

# ---- Meta (Facebook + Instagram) ----
# From developers.facebook.com > Your App > Settings > Basic
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v20.0

# ---- Google (YouTube + GA4) ----
# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- LinkedIn (Ad Analytics) ----
# From developer.linkedin.com > Your App > Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
